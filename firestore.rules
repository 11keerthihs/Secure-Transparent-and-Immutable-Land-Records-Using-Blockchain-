rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check authentication
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper function to check if current user is owner of the document
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // --- Users Collection ---
    // Users can read and write only their own profile
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create, update: if isOwner(userId);
      allow delete: if false; // Profiles cannot be deleted without audit
    }

    // --- Government ID Index (Duplicate Prevention) ---
    // Enforces single registration per unique SHA-256 Government ID hash
    match /govIdIndex/{govIdHash} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && !exists(/databases/$(database)/documents/govIdIndex/$(govIdHash));
      allow update: if isAuthenticated() && resource.data.uid == request.auth.uid;
      allow delete: if false;
    }

    // --- Land Listings (Marketplace) ---
    // Public read for authenticated citizens; sellers can manage their own listings
    match /landListings/{listingId} {
      allow read: if true; // Public marketplace access
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && (
        resource.data.sellerUid == request.auth.uid || 
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
      );
      allow delete: if isAuthenticated() && resource.data.sellerUid == request.auth.uid;
    }

    // --- Buyer Interests & Proposals ---
    match /interests/{interestId} {
      allow read: if isAuthenticated() && (
        resource.data.buyerUid == request.auth.uid ||
        resource.data.sellerUid == request.auth.uid
      );
      allow create: if isAuthenticated() && request.resource.data.buyerUid == request.auth.uid;
      allow update: if isAuthenticated() && (
        resource.data.buyerUid == request.auth.uid ||
        resource.data.sellerUid == request.auth.uid
      );
      allow delete: if isAuthenticated() && resource.data.buyerUid == request.auth.uid;
    }

    // --- Transfer History (Audit Trail) ---
    // Read-only for authenticated users; append-only audit trail
    match /transfers/{transferId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if false; // Immutable audit log
    }
  }
}
