# ===================================================================
# IMMUTABLE LAND RECORD MANAGEMENT USING BLOCKCHAIN TECHNOLOGY
# Environment Configuration
# ===================================================================

# --- Firebase Configuration ---
# Create a Firebase project at https://console.firebase.google.com/
# Enable Authentication (Email/Password and Google sign-in provider)
# Create a Cloud Firestore database in test mode or with firestore.rules
# Add localhost to Authorized Domains in Firebase Authentication Settings

# Support for Create React App (REACT_APP_) and Vite (VITE_) conventions:
REACT_APP_FIREBASE_API_KEY=
REACT_APP_FIREBASE_AUTH_DOMAIN=
REACT_APP_FIREBASE_PROJECT_ID=
REACT_APP_FIREBASE_STORAGE_BUCKET=
REACT_APP_FIREBASE_MESSAGING_SENDER_ID=
REACT_APP_FIREBASE_APP_ID=

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# --- Government Administrator Whitelist ---
# Comma-separated list of authorized government officer emails
# Non-whitelisted Google accounts will be rejected with "Access denied"
REACT_APP_ADMIN_EMAILS=admin@example.com,gov.admin@landregistry.gov,hskeerthi11@gmail.com
VITE_ADMIN_EMAILS=admin@example.com,gov.admin@landregistry.gov,hskeerthi11@gmail.com

# --- Blockchain Network & Smart Contract Configuration ---
# Ganache local Ethereum RPC URL and Chain ID 1337
REACT_APP_GANACHE_RPC=http://127.0.0.1:7545
VITE_GANACHE_RPC=http://127.0.0.1:7545

# Deployed LandRegistry.sol contract address (automatically updated by deploy scripts)
# Example: 0x5FbDB2315678afecb367f032d93F642f64180aa3
REACT_APP_LAND_REGISTRY_ADDRESS=
VITE_LAND_REGISTRY_ADDRESS=

# Optional Block Explorer Base URL
REACT_APP_BLOCK_EXPLORER_TX_BASE=
VITE_BLOCK_EXPLORER_TX_BASE=
